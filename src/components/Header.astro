---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { ui, defaultLang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  profile: {
    name: string;
  };
  showLangSwitch?: boolean;
}

const { profile, showLangSwitch = true } = Astro.props;
const lang = (Astro.currentLocale ?? defaultLang) as keyof typeof ui;
const t = useTranslations(lang);

const navItems = [
  { key: 'nav.home', href: getRelativeLocaleUrl(lang, '') },
  { key: 'nav.about', href: getRelativeLocaleUrl(lang, 'about') },
  { key: 'nav.projects', href: getRelativeLocaleUrl(lang, 'projects') },
  { key: 'nav.blog', href: getRelativeLocaleUrl(lang, 'blog') },
  { key: 'nav.links', href: getRelativeLocaleUrl(lang, 'links') },
] as const;

const currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/');
---

<header class="site-header" data-astro-transition-persist>
  <div class="container header-inner">
    <a class="site-name" href={navItems[0].href}>{profile.name}</a>
    <nav class="site-nav">
      {navItems.map((item) => {
        const itemPath = item.href.replace(import.meta.env.BASE_URL, '/');
        const active = item.key === 'nav.home'
          ? currentPath === '/'
          : currentPath.startsWith(itemPath + '/') || currentPath === itemPath;
        return (
          <a
            href={item.href}
            class:list={['nav-link', { active }]}
            aria-current={active ? 'page' : undefined}
          >
            {t(item.key)}
          </a>
        );
      })}
    </nav>
    <ThemeToggle />
    {showLangSwitch && <LanguageSwitcher />}
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--hairline);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 4rem;
  }

  .site-name {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.15rem;
    letter-spacing: 0.01em;
    color: var(--ink);
    white-space: nowrap;
  }

  .site-name:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    gap: 1.4rem;
    flex: 1;
  }

  .nav-link {
    color: var(--ink-soft);
    font-size: 0.92rem;
    letter-spacing: 0.03em;
    padding: 0.25rem 0;
    border-bottom: 1px solid transparent;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .nav-link:hover {
    color: var(--ink);
    border-bottom-color: var(--hairline-strong);
    text-decoration: none;
  }

  .nav-link.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  @media (max-width: 640px) {
    .header-inner {
      gap: 0.9rem;
    }

    .site-nav {
      gap: 0.9rem;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .site-nav::-webkit-scrollbar {
      display: none;
    }

    .nav-link {
      font-size: 0.88rem;
      white-space: nowrap;
    }
  }
</style>
