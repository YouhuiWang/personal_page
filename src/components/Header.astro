---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { ui, defaultLang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { profile } from '../data/site';

const lang = (Astro.currentLocale ?? defaultLang) as keyof typeof ui;
const t = useTranslations(lang);

const navItems = [
  { key: 'nav.home', href: getRelativeLocaleUrl(lang, '') },
  { key: 'nav.about', href: getRelativeLocaleUrl(lang, 'about') },
  { key: 'nav.projects', href: getRelativeLocaleUrl(lang, 'projects') },
  { key: 'nav.blog', href: getRelativeLocaleUrl(lang, 'blog') },
  { key: 'nav.links', href: getRelativeLocaleUrl(lang, 'links') },
] as const;

const currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/');
---

<header class="site-header" data-astro-transition-persist>
  <div class="container header-inner">
    <a class="site-name" href={navItems[0].href}>{profile.name}</a>
    <nav class="site-nav">
      {navItems.map((item) => {
        const itemPath = item.href.replace(import.meta.env.BASE_URL, '/');
        const active = item.key === 'nav.home'
          ? currentPath === '/'
          : currentPath.startsWith(itemPath + '/') || currentPath === itemPath;
        return (
          <a
            href={item.href}
            class:list={['nav-link', { active }]}
            aria-current={active ? 'page' : undefined}
          >
            {t(item.key)}
          </a>
        );
      })}
    </nav>
    <LanguageSwitcher />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(8, 12, 22, 0.55);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    backdrop-filter: blur(18px) saturate(160%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.2);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: 3.75rem;
  }

  .site-name {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text);
    white-space: nowrap;
    background: linear-gradient(120deg, #fff 30%, var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .site-name:hover {
    text-decoration: none;
    filter: brightness(1.15);
  }

  .site-nav {
    display: flex;
    gap: 0.35rem;
    flex: 1;
  }

  .nav-link {
    color: var(--text-muted);
    font-size: 0.95rem;
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    border: 1px solid transparent;
    transition:
      background 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
    position: relative;
  }

  .nav-link:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.1);
    text-decoration: none;
  }

  .nav-link.active {
    color: #fff;
    background: linear-gradient(135deg, rgba(122, 165, 255, 0.28), rgba(192, 141, 255, 0.24));
    border-color: rgba(122, 165, 255, 0.35);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.18),
      0 4px 16px rgba(80, 120, 255, 0.18);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  @media (max-width: 640px) {
    .header-inner {
      gap: 0.5rem;
    }

    .site-nav {
      gap: 0.15rem;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .site-nav::-webkit-scrollbar {
      display: none;
    }

    .nav-link {
      padding: 0.35rem 0.7rem;
      font-size: 0.88rem;
    }
  }
</style>
