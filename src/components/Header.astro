---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { ui, defaultLang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { profile } from '../data/site';

const lang = (Astro.currentLocale ?? defaultLang) as keyof typeof ui;
const t = useTranslations(lang);

const navItems = [
  { key: 'nav.home', href: getRelativeLocaleUrl(lang, '') },
  { key: 'nav.about', href: getRelativeLocaleUrl(lang, 'about') },
  { key: 'nav.projects', href: getRelativeLocaleUrl(lang, 'projects') },
  { key: 'nav.blog', href: getRelativeLocaleUrl(lang, 'blog') },
  { key: 'nav.links', href: getRelativeLocaleUrl(lang, 'links') },
] as const;

const currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/');
---

<header class="site-header">
  <div class="container header-inner">
    <a class="site-name" href={navItems[0].href}>{profile.name}</a>
    <nav class="site-nav">
      {navItems.map((item) => {
        const active = item.key === 'nav.home'
          ? currentPath === '/'
          : currentPath.startsWith(item.href.replace(import.meta.env.BASE_URL, '/') + '/') ||
            currentPath === item.href.replace(import.meta.env.BASE_URL, '/');
        return (
          <a
            href={item.href}
            class:list={['nav-link', { active }]}
            aria-current={active ? 'page' : undefined}
          >
            {t(item.key)}
          </a>
        );
      })}
    </nav>
    <LanguageSwitcher />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 3.5rem;
  }

  .site-name {
    font-weight: 700;
    color: var(--text);
    white-space: nowrap;
  }

  .site-name:hover {
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    gap: 1.25rem;
    flex: 1;
  }

  .nav-link {
    color: var(--text-muted);
    font-size: 0.95rem;
    padding: 0.2rem 0;
    border-bottom: 2px solid transparent;
  }

  .nav-link:hover {
    color: var(--text);
    text-decoration: none;
  }

  .nav-link.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  @media (max-width: 640px) {
    .header-inner {
      gap: 0.75rem;
    }

    .site-nav {
      gap: 0.75rem;
      overflow-x: auto;
    }
  }
</style>
