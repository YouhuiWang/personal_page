---
import type { CollectionEntry } from 'astro:content';

type LinkItemData = CollectionEntry<'links'>['data'];

interface Props {
  item: LinkItemData;
}

const { item } = Astro.props;
const lang = (Astro.currentLocale ?? 'zh') as 'zh' | 'en';
---

<a class="link-item reveal" href={item.url} target="_blank" rel="noopener noreferrer">
  <span class="link-label">{item.label}</span>
  <span class="link-desc">{item.description[lang]}</span>
</a>

<style>
  .link-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.1rem 0.2rem;
    border-bottom: 1px solid var(--hairline);
    color: inherit;
    transition: padding 0.3s ease;
  }

  .link-item:hover {
    text-decoration: none;
    padding-left: 0.6rem;
  }

  .link-label {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.1rem;
    color: var(--ink);
  }

  .link-item:hover .link-label {
    color: var(--accent);
  }

  .link-desc {
    color: var(--ink-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .link-item {
      flex-direction: column;
      gap: 0.2rem;
    }
  }
</style>
