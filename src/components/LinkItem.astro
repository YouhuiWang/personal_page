---
import type { LinkItem as LinkItemData } from '../data/site';

interface Props {
  item: LinkItemData;
}

const { item } = Astro.props;
const lang = (Astro.currentLocale ?? 'zh') as 'zh' | 'en';
---

<a class="card link-item" href={item.url} target="_blank" rel="noopener noreferrer">
  <span class="link-label">{item.label}</span>
  <span class="link-desc">{item.description[lang]}</span>
</a>

<style>
  .link-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .link-label {
    font-weight: 600;
    color: var(--accent);
  }

  .link-desc {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .link-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
  }
</style>
