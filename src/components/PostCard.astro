---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, description, pubDate, tags } = entry.data;
const lang = (Astro.currentLocale ?? 'zh') as 'zh' | 'en';
const href = getRelativeLocaleUrl(lang, `blog/${entry.id.split('/').slice(1).join('/')}`);
const dateFormatter = new Intl.DateTimeFormat(lang === 'zh' ? 'zh-CN' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a class="post-item reveal" href={href}>
  <time class="post-item-date" datetime={pubDate.toISOString()}>
    {dateFormatter.format(pubDate)}
  </time>
  <h3>{title}</h3>
  <p>{description}</p>
  {tags && (
    <div>
      {tags.map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </div>
  )}
</a>

<style>
  .post-item {
    display: block;
    padding: 1.4rem 0.2rem;
    border-bottom: 1px solid var(--hairline);
    color: inherit;
    transition: padding 0.3s ease;
  }

  .post-item:hover {
    text-decoration: none;
    padding-left: 0.6rem;
  }

  .post-item-date {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }

  .post-item h3 {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 500;
    margin-bottom: 0.4rem;
    color: var(--ink);
  }

  .post-item:hover h3 {
    color: var(--accent);
  }

  .post-item p {
    color: var(--ink-muted);
    font-size: 0.95rem;
    margin: 0 0 0.6rem;
    max-width: 34em;
  }
</style>
