---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, description, pubDate, tags } = entry.data;
const lang = (Astro.currentLocale ?? 'zh') as 'zh' | 'en';
const href = getRelativeLocaleUrl(lang, `blog/${entry.id.split('/').slice(1).join('/')}`);
const dateFormatter = new Intl.DateTimeFormat(lang === 'zh' ? 'zh-CN' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a class="card post-card" href={href}>
  <h3>{title}</h3>
  <p>{description}</p>
  <div class="post-card-meta">
    <time datetime={pubDate.toISOString()}>{dateFormatter.format(pubDate)}</time>
    {tags && (
      <span>
        {tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </span>
    )}
  </div>
</a>

<style>
  .post-card h3 {
    margin-bottom: 0.4rem;
    font-size: 1.1rem;
  }

  .post-card p {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin: 0 0 0.75rem;
  }

  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
</style>
