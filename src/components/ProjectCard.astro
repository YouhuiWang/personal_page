---
import type { CollectionEntry } from 'astro:content';

type Project = CollectionEntry<'projects'>['data'];

interface Props {
  project: Project;
}

const { project } = Astro.props;
const lang = (Astro.currentLocale ?? 'zh') as 'zh' | 'en';
---

<a class="card project-card reveal" href={project.url} target="_blank" rel="noopener noreferrer">
  <h3>{project.title[lang]}</h3>
  <p>{project.description[lang]}</p>
  {project.tags && (
    <div>
      {project.tags.map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </div>
  )}
</a>

<style>
  .project-card h3 {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 500;
    margin-bottom: 0.4rem;
  }

  .project-card p {
    color: var(--ink-muted);
    font-size: 0.95rem;
    margin: 0 0 0.75rem;
    max-width: 34em;
  }

  .project-card:hover h3 {
    color: var(--accent);
  }
</style>
