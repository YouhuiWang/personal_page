---
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { defaultLang } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  /** 非 locale 页面（如 404）关闭语言切换器 */
  showLangSwitch?: boolean;
}

const { title, description, showLangSwitch = true } = Astro.props;
const lang = Astro.currentLocale ?? defaultLang;
const siteTitle = title;
const siteDescription = description ?? title;
const [profileEntry] = await getCollection('profile');
const profile = profileEntry?.data;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + 'favicon.svg'} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // 主题初始化：首帧前写入 data-theme，避免闪烁（FOUC）
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var pref =
            stored === 'light' || stored === 'dark' || stored === 'system'
              ? stored
              : 'system';
          var resolved =
            pref === 'system'
              ? window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light'
              : pref;
          document.documentElement.dataset.theme = resolved;
          document.documentElement.dataset.themePref = pref;
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
    <ClientRouter />
    <style is:global>
      /* 页面切换过渡：柔和淡入 + 轻微上移 */
      ::view-transition-old(root) {
        animation: vt-out 0.25s ease both;
      }

      ::view-transition-new(root) {
        animation: vt-in 0.4s ease both;
      }

      @keyframes vt-out {
        to {
          opacity: 0;
          transform: translateY(-6px);
        }
      }

      @keyframes vt-in {
        from {
          opacity: 0;
          transform: translateY(10px);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none;
        }
      }
    </style>
  </head>
  <body>
    {profile && <Header profile={profile} showLangSwitch={showLangSwitch} />}
    <main>
      <slot />
    </main>
    {profile && <Footer profile={profile} />}

    <script>
      // 主题切换：事件委托 + 幂等守卫（Header 跨 View Transition 持久，避免重复监听）
      // localStorage 是唯一数据源；html 上的 data-theme / data-theme-pref 只是渲染镜像
      (function () {
        var root = document.documentElement;
        if (root.dataset.themeBound === '1') return;
        root.dataset.themeBound = '1';

        var mq = window.matchMedia('(prefers-color-scheme: dark)');

        function currentPref() {
          var p = localStorage.getItem('theme');
          return p === 'light' || p === 'dark' || p === 'system' ? p : 'system';
        }

        function apply() {
          var pref = currentPref();
          var resolved = pref === 'system' ? (mq.matches ? 'dark' : 'light') : pref;
          root.dataset.theme = resolved;
          root.dataset.themePref = pref;
        }

        document.addEventListener('click', function (e) {
          var btn = e.target.closest('[data-theme-toggle]');
          if (!btn) return;
          var cur = currentPref();
          var next = cur === 'light' ? 'dark' : cur === 'dark' ? 'system' : 'light';
          try {
            localStorage.setItem('theme', next);
          } catch (e) {}
          apply();
        });

        mq.addEventListener('change', function () {
          if (currentPref() === 'system') apply();
        });

        apply();
      })();

      // 滚动进入动画：元素进入视口时淡入上浮
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.08 },
      );

      function observeReveals() {
        document.querySelectorAll('.reveal:not(.visible)').forEach((el) => observer.observe(el));
      }

      observeReveals();
      // View Transitions 导航后新页面元素需要重新观察
      document.addEventListener('astro:page-load', observeReveals);
    </script>
  </body>
</html>
