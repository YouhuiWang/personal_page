---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui, defaultLang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { profile } from '../data/site';

const lang = (Astro.currentLocale ?? defaultLang) as keyof typeof ui;
const t = useTranslations(lang);
---

<BaseLayout title={`${t('about.title')} · ${profile.name}`} description={profile.bio[lang]}>
  <div class="container">
    <header class="page-header">
      <h1>{t('about.title')}</h1>
      <p>{profile.bio[lang]}</p>
    </header>

    <section class="about-section">
      <h2 class="section-title">{lang === 'zh' ? '基本信息' : 'Basic Info'}</h2>
      <ul class="info-list">
        <li>
          <span class="info-label">{lang === 'zh' ? '姓名' : 'Name'}</span>
          <span>{profile.name}</span>
        </li>
        <li>
          <span class="info-label">{lang === 'zh' ? '所在地' : 'Location'}</span>
          <span>{profile.location}</span>
        </li>
        <li>
          <span class="info-label">Email</span>
          <span>
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
          </span>
        </li>
        <li>
          <span class="info-label">GitHub</span>
          <span>
            <a href={profile.github} target="_blank" rel="noopener noreferrer">{profile.github}</a>
          </span>
        </li>
      </ul>
    </section>

    <!-- 在此补充教育经历、工作经历、技能等内容 -->
    <section class="about-section">
      <h2 class="section-title">{lang === 'zh' ? '经历' : 'Experience'}</h2>
      <p class="placeholder">{lang === 'zh' ? '（内容待补充）' : '(To be added)'}</p>
    </section>

    <section class="about-section">
      <h2 class="section-title">{lang === 'zh' ? '技能' : 'Skills'}</h2>
      <p class="placeholder">{lang === 'zh' ? '（内容待补充）' : '(To be added)'}</p>
    </section>
  </div>
</BaseLayout>

<style>
  .about-section {
    margin-bottom: 1rem;
  }

  .info-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .info-list li {
    display: flex;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
  }

  .info-list li:last-child {
    border-bottom: none;
  }

  .info-label {
    width: 5.5rem;
    flex-shrink: 0;
    color: var(--text-muted);
  }

  .placeholder {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
</style>
