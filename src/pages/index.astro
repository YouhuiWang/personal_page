---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { ui, defaultLang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { profile, projects } from '../data/site';

const lang = (Astro.currentLocale ?? defaultLang) as keyof typeof ui;
const t = useTranslations(lang);

const recentPosts = (await getCollection('blog', ({ id }) => id.startsWith(`${lang}/`)))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const featuredProjects = projects.slice(0, 3);
---

<BaseLayout title={`${profile.name} · ${t('hero.subtitle')}`} description={profile.bio[lang]}>
  <section class="hero container">
    <h1 class="hero-title reveal">{t('hero.tagline')}</h1>
    <p class="hero-bio reveal">{profile.bio[lang]}</p>
    <div class="hero-actions reveal">
      <a class="btn" href={getRelativeLocaleUrl(lang, 'about')}>{t('nav.about')}</a>
      <a class="btn btn-ghost" href={getRelativeLocaleUrl(lang, 'blog')}>{t('nav.blog')}</a>
    </div>
    <div class="hero-scroll" aria-hidden="true"></div>
  </section>

  {recentPosts.length > 0 && (
    <section class="container">
      <h2 class="section-title reveal">{t('section.latestPosts')}</h2>
      <div class="post-grid">
        {recentPosts.map((post) => <PostCard entry={post} />)}
      </div>
    </section>
  )}

  {featuredProjects.length > 0 && (
    <section class="container">
      <h2 class="section-title reveal">{t('section.projects')}</h2>
      <div class="project-grid">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    padding: 7rem 1.25rem 2.5rem;
    max-width: var(--container);
    text-align: center;
  }

  .hero-title {
    font-size: 2.9rem;
    font-weight: 700;
    margin-bottom: 1rem;
    background: linear-gradient(120deg, #ffffff 15%, var(--accent) 55%, var(--accent-2) 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: 0 0 40px rgba(122, 165, 255, 0.25);
  }

  .hero-bio {
    color: var(--text-muted);
    font-size: 1.12rem;
    max-width: 34rem;
    margin: 0 auto 2.25rem;
  }

  .hero-actions {
    display: flex;
    gap: 0.9rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero-scroll {
    width: 26px;
    height: 44px;
    margin: 4.5rem auto 0;
    border: 2px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    position: relative;
  }

  .hero-scroll::after {
    content: '';
    position: absolute;
    top: 8px;
    left: 50%;
    width: 4px;
    height: 8px;
    border-radius: 2px;
    background: var(--accent);
    transform: translateX(-50%);
    animation: scroll-hint 2s ease-in-out infinite;
  }

  @keyframes scroll-hint {
    0% {
      opacity: 0;
      transform: translate(-50%, 0);
    }
    40% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(-50%, 14px);
    }
  }

  .post-grid,
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.1rem;
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 4.5rem;
    }

    .hero-title {
      font-size: 2rem;
    }
  }
</style>
